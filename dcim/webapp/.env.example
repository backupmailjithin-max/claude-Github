# =============================================================================
# DCIM Dashboard — environment configuration
# Copy this file to .env and edit the values for your site, then restart the
# DCIM service. Everything below REQUIRED is needed to start; everything
# under OPTIONAL has a safe built-in default and only needs to be set if you
# want to change that behavior.
# =============================================================================

# ---- REQUIRED -----------------------------------------------------------
PORT=8974
DB_HOST=localhost
DB_USER=dcim
DB_PASSWORD=CHANGE_ME
DB_NAME=dcim
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
CORS_ORIGIN=https://your-dcim-hostname

# =============================================================================
# HARDWARE MONITORING INTEGRATION — Dell OME / HPE OneView API (optional)
# =============================================================================
# Lets the dashboard pull live server/power/firmware status from your Dell
# OpenManage Enterprise (OME) and/or HPE OneView appliances. This is entirely
# optional — a site/zone with no matching variables below just shows as
# "not configured" instead of erroring.
#
# You can monitor MULTIPLE appliances, one set per SITE + ZONE combination
# (the same Site / Zone names you use in Asset Inventory). Add one block of
# three variables per product, per site+zone you want monitored, using this
# naming pattern:
#
#   OME_<SITE>_<ZONE>_HOST=https://your-ome-appliance:443
#   OME_<SITE>_<ZONE>_USER=api-service-account
#   OME_<SITE>_<ZONE>_PASS=CHANGE_ME
#
#   ONEVIEW_<SITE>_<ZONE>_HOST=https://your-oneview-appliance:443
#   ONEVIEW_<SITE>_<ZONE>_USER=api-service-account
#   ONEVIEW_<SITE>_<ZONE>_PASS=CHANGE_ME
#
# <SITE> and <ZONE> are your site/zone names, upper-cased with every
# character that isn't a letter or digit removed. Example: site "Chennai",
# zone "AZ-1" -> CHENNAI_AZ1. So monitoring HPE OneView for that zone would
# be: ONEVIEW_CHENNAI_AZ1_HOST / ONEVIEW_CHENNAI_AZ1_USER / ONEVIEW_CHENNAI_AZ1_PASS.
#
# --- Sample entry: rename SITE1_ZONE1 below to match one of your real
#     site+zone names, uncomment, and fill in real values. Duplicate the
#     block (with a different SITE/ZONE) for every appliance you have. ---
# OME_SITE1_ZONE1_HOST=https://ome.example.local
# OME_SITE1_ZONE1_USER=api-service-account
# OME_SITE1_ZONE1_PASS=CHANGE_ME
#
# ONEVIEW_SITE1_ZONE1_HOST=https://oneview.example.local
# ONEVIEW_SITE1_ZONE1_USER=api-service-account
# ONEVIEW_SITE1_ZONE1_PASS=CHANGE_ME
#
# Optional: pin the HPE OneView REST API version instead of letting the
# server auto-discover it per appliance (GET /rest/version) — only needed if
# auto-discovery doesn't work for your appliance/firmware combination.
# ONEVIEW_API_VERSION=3200
#
# Optional: iLO integration uses HTTPS by default; set to "http" only if your
# iLOs are not reachable over HTTPS from this server.
# ILO_SCHEME=https

# =============================================================================
# OPTIONAL — security & sessions
# =============================================================================
# NODE_ENV=production                  # enables stricter checks (e.g. requires JWT_SECRET to be set)
# SESSION_TIMEOUT_HOURS=8              # how long a login stays valid
# CSP_MODE=report-only                 # enforce | report-only | off
# CORP_POLICY=same-origin              # Cross-Origin-Resource-Policy header value
# TRUST_PROXY=                         # set when running behind nginx/HAProxy (e.g. 1, or the proxy's IP)
# HTTPS_ENABLED=false                  # set true if TLS terminates on this process itself
# HSTS_MAX_AGE=86400                   # seconds; raise to 31536000 once HTTPS is confirmed working
# LOGIN_LOCK_ACCOUNT=on                # lock an account after repeated failed logins (on|off)

# =============================================================================
# OPTIONAL — database tuning
# =============================================================================
# DB_PORT=3306
# DB_POOL_SIZE=25                      # lower this if your MySQL/MariaDB max_connections is constrained

# =============================================================================
# OPTIONAL — performance / API tuning
# =============================================================================
# SLOW_QUERY_MS=500                    # queries slower than this are flagged in perf stats
# SLOW_API_MS=1500                     # API responses slower than this are flagged in perf stats
# API_CACHE_TTL_MS=15000               # 0 disables the in-memory API response cache
# API_CACHE_MAX_MB=64
# STATIC_COMPRESS=on                   # pre-compress static assets on startup (on|off)

# =============================================================================
# OPTIONAL — hardware monitoring refresh intervals
# =============================================================================
# MONITOR_CACHE_TTL_MS=300000          # 5 min: how long OME/OneView device snapshots are cached
# MONITOR_FW_SCAN=on                   # background firmware-status scan (on|off)
# MONITOR_FW_SCAN_MS=30000
# MONITOR_FW_JOB_TTL_MS=10800000       # 3h: how long a tracked firmware job stays visible
# MONITOR_AUTOSYNC_INTERVAL_MS=1800000 # 30 min: power-state auto-sync cycle

# =============================================================================
# OPTIONAL — PDU power monitoring
# =============================================================================
# PDU_POLL=on                           # background SNMP poll of every configured PDU (on|off)
# PDU_POLL_INTERVAL_MS=900000           # 15 min default; how often PDUs are polled automatically
#
# Optional: "Discover PDUs" (PDU Power page) scans an IP range via SNMP and
# reports what it finds - it never saves anything by itself, you review and
# apply/add from the results. SNMP alone cannot tell you which physical
# Site/Zone a responding IP belongs to, so each range is mapped to one here.
# Rack No still has to be entered by a person per device - that's genuinely
# not visible over the network. Multiple ranges separated by ';'.
# Format per range:  startIP-endIP:Site:Zone   (the Site name must exactly
# match an existing site/location name, and must not itself contain a ':')
# PDU_DISCOVERY_RANGES=10.20.4.100-10.20.4.160:Sample Site A:AZ-1;10.20.5.1-10.20.5.50:Sample Site B:AZ-1
#
# One shared SNMP v2c community string used for every host in every range
# above - the closest equivalent SNMP v2c has to a single shared
# "username and password" across a batch-deployed PDU fleet. There is no
# SNMPv3 (per-device auth/priv credentials) support.
# PDU_DISCOVERY_COMMUNITY=public

# =============================================================================
# OPTIONAL — Multi-vendor server hardware monitoring (Redfish)
# =============================================================================
# Works directly against any server's management port (BMC) that speaks the
# DMTF Redfish standard - Dell iDRAC, HPE iLO, Lenovo XClarity Controller,
# Cisco standalone IMC, NVIDIA DGX, and most others - without needing a
# vendor appliance like Dell OME or HPE OneView. This is additional to those,
# not a replacement; see Monitoring -> "Multi-Vendor (Redfish)".
#
# Per-device credentials are saved from that page's "Test & Detect" (stored
# on the asset itself, one BMC username/password per server). The two
# variables below are only needed for the optional "Discover" bulk scan,
# which tries ONE shared credential against every asset that already has a
# management IP but no Redfish credentials saved yet - the closest
# equivalent a batch-deployed fleet has to a single shared login, same
# pattern as PDU_DISCOVERY_COMMUNITY above. Leave unset to use "Test &
# Detect" one device at a time instead.
# REDFISH_DEFAULT_USERNAME=admin
# REDFISH_DEFAULT_PASSWORD=change-me

# =============================================================================
# OPTIONAL — backups
# =============================================================================
# BACKUP_RETENTION_DAYS=7
# BACKUP_TIME=23:00                    # HH:MM, server local time
# BACKUP_DIR=                          # defaults to ./backups next to server.js
# BACKUP_CATCHUP=on                    # take a backup shortly after startup if one was missed (on|off)
# BACKUP_CATCHUP_DELAY_MS=20000

# =============================================================================
# OPTIONAL — logging & misc
# =============================================================================
# LOG_TO_FILE=on
# LOG_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365             # 0 = keep audit trail forever
# MEMORY_MONITOR=on
# BIND_HOST=                           # e.g. 127.0.0.1 to listen only on localhost (nginx in front)
# LICENSE_FILE=                        # defaults to license.lic next to server.js
# NORMALIZE_U_FORMAT=on

# =============================================================================
# OPTIONAL — document OCR (asset document text search)
# =============================================================================
# OCR_ENABLED=on
# OCR_TIMEOUT_MS=90000
# OCR_IDLE_MS=120000
# OCR_MAX_PAGES=5
# OCR_MAX_QUEUE=3
# OCR_MAX_PIXELS=40000000
