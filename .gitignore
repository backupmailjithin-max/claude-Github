# staged at package-build time, not committed
packaging/linux/runtime/
packaging/windows/runtime/
packaging/windows/tools/
packaging/windows/Output/
# repo-root build output only (packaging/*/build-*.sh write here) -- anchored
# with a leading slash so it does NOT also match node_modules/*/dist/, which
# bypassed bcryptjs's required ./dist/bcrypt.js and broke every real install
/dist/

# licensing (see docs/LICENSING.md): the signing PRIVATE key must never be
# committed, and issued customer license files have no reason to be in the
# repo either. The PUBLIC key lives in code (dcim/webapp/lib/license-public-key.js)
# and is fine to commit.
license-private-key*.pem
*.lic
dcim/webapp/license.lic

# runtime output, not source - dcim/webapp/logs/.gitkeep keeps the folder
dcim/webapp/logs/*.log

# per-install 10-day trial record (see docs/LICENSING.md) - never ship or commit
dcim/webapp/.trial-state
dcim/webapp/.license-clock
dcim/webapp/integrity.manifest.json
